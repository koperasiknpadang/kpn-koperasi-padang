rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin'];
    }

    // Transactions may only be created in an open period. getAfter permits
    // the period document to be created in the same atomic transaction.
    function periodIsOpen(periodId) {
      return getAfter(/databases/$(database)/documents/periods/$(periodId)).data.status == 'open';
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /public_summaries/{summaryId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /loan_applications/{applicationId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /loans/{loanId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /savings_transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && periodIsOpen(request.resource.data.periodId);
      allow update, delete: if false;
    }

    match /installments/{installmentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && periodIsOpen(request.resource.data.periodId);
      allow update, delete: if false;
    }

    match /cash_transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && periodIsOpen(request.resource.data.periodId);
      allow update, delete: if false;
    }

    match /journal_entries/{journalId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && periodIsOpen(request.resource.data.periodId);
      allow update, delete: if false;
    }

    match /periods/{periodId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'open'
        && request.resource.data.periodId == periodId;
      allow update: if isAdmin()
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.periodId == periodId;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Legacy import collections remain readable for controlled migration,
    // but are not used as the source of truth by the operational application.
    match /loan_snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /monthly_records/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
