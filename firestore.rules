rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin'];
    }

    // Pengguna hanya dapat membaca dokumen admin miliknya sendiri.
    // Perubahan role hanya boleh dilakukan dari Firebase Console / lingkungan tepercaya.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Hanya ringkasan agregat yang boleh dibaca tanpa login.
    match /public_summaries/{summaryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read, write: if isAdmin();
    }

    match /loans/{loanId} {
      allow read, write: if isAdmin();
    }

    match /periods/{periodId} {
      allow read, write: if isAdmin();
    }

    match /monthly_records/{recordId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Semua koleksi lain tertutup secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}