rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin'];
    }

    function periodIsDraft(periodId) {
      return getAfter(/databases/$(database)/documents/periods/$(periodId)).data.status == 'draft';
    }

    // Admin documents are provisioned only by the project owner through Firebase Console.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Only explicitly published aggregate summaries are public.
    match /public_summaries/{summaryId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Current convenience view; history is kept in loan_snapshots.
    match /loans/{loanId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /loan_snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && periodIsDraft(request.resource.data.periodId);
      allow update: if false;
      allow delete: if isAdmin() && periodIsDraft(resource.data.periodId);
    }

    match /periods/{periodId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.periodId == resource.data.periodId;
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    match /monthly_records/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && periodIsDraft(request.resource.data.periodId);
      allow update: if false;
      allow delete: if isAdmin() && periodIsDraft(resource.data.periodId);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
